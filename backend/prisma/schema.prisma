generator client {
  provider = "prisma-client-js"

}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Role {
  developer
  admin
}

enum KeyStatus {
  active
  revoked
}

model User {
  id            String  @id
  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?

  companyName String?
  role        String  @default("developer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  apiKeys     ApiKey[]
  logs        UsageLog[]
  receiptLogs ReceiptLog[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id         String @id
  accountId  String
  providerId String
  userId     String

  accessToken           String?
  scope        String?  
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?

  password String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ApiKey {
  id         Int       @id @default(autoincrement())
  userId     String
  name       String
  key        String    @unique
  prefix     String
  status     String    @default("active")
  dailyLimit Int       @default(100)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  user User       @relation(fields: [userId], references: [id])
  logs UsageLog[]
}

model UsageLog {
  id             Int      @id @default(autoincrement())
  userId         String
  apiKeyId       Int
  endpoint       String
  method         String
  statusCode     Int
  responseTimeMs Int
  ipAddress      String?
  createdAt      DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  apiKey ApiKey @relation(fields: [apiKeyId], references: [id])
}

model ReceiptLog {
  id        Int      @id @default(autoincrement())
  userId    String
  reference String?
  amount    Float?
  status    String
  provider  String // mpesa, cbe, etc
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
model VerificationLog {
  id           String   @id @default(cuid())
  status       String   // success | fraud | failed
  provider     String
  responseTime Int
  createdAt    DateTime @default(now())
}